PORT=5000
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
CLIENT_URL=https://aakashpate.github.io

# Required in production: secret used to sign login (JWT) sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: token lifetime (default 30d)
# JWT_EXPIRES_IN=30d

# Optional: extra CORS origins, comma separated (http://localhost:5173 is always allowed)
# CLIENT_URLS=http://localhost:5173,https://example.com

# Optional: set by your hosting provider (Render/Railway/Vercel set this automatically)
# NODE_ENV=production
# HOST=0.0.0.0

# Optional: run without MongoDB in production (messages are lost on every restart).
# Without this, a missing MONGODB_URI in production is a fatal error.
# ALLOW_MEMORY_DB=true
